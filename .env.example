# --- App ---
ENVIRONMENT=local
DEBUG=true

# Set to false only once real provider keys below are filled in.
# In demo mode every MCP tool and the LLM/RAG layer use deterministic
# mock providers, so the app is fully runnable with no keys at all.
DEMO_MODE=true

# --- Security (Phase 12) ---
# Generate a real key: python -c "import secrets; print(secrets.token_urlsafe(48))"
# staging/production refuse to start with a default or <32 char key.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
# AUTH_REQUIRED=false is a local/test-only trusted-caller mode; production refuses it.
AUTH_REQUIRED=true
ALLOW_REGISTRATION=true
# JSON list of emails allowed to call /api/rag/ingest
ADMIN_EMAILS=[]
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
MAX_REQUEST_BODY_BYTES=6000000

# --- Observability (Phase 12) ---
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
METRICS_ENABLED=true
# If set, /api/metrics requires "Authorization: Bearer <token>" (required in production)
METRICS_TOKEN=

# --- Database ---
# Local default (no setup needed): sqlite:///./pathforge.db
# docker-compose overrides this to Postgres, e.g.:
# postgresql+psycopg2://pathforge:pathforge@db:5432/pathforge
DATABASE_URL=sqlite:///./pathforge.db

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- LLM provider (wired up in Phase 4) ---
# LLM_PROVIDER=mock is not a real provider — it exists only so
# RealLLMProvider fails loudly if selected without DEMO_MODE=true.
# Use LLM_PROVIDER=anthropic + LLM_API_KEY for a real agent LLM.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# --- Agent execution bounds (Phase 4) ---
AGENT_MAX_TOOL_CALLS=5
AGENT_TOOL_TIMEOUT_SECONDS=20

# --- MCP servers ---
# MCP_*_SERVER_URL: reserved for the Phase 4 agent's MCP client once
# servers run over HTTP transport instead of stdio subprocess. Unused
# by the servers themselves today (they run via `python server.py`).
MCP_GITHUB_SERVER_URL=
MCP_SEARCH_SERVER_URL=
MCP_LEARNING_SERVER_URL=

# Read directly by mcp-servers/common/config.py (each server is a
# standalone process with its own env, not this file — copy the
# relevant lines to mcp-servers/.env for local MCP server runs).
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
SEARCH_PROVIDER_API_KEY=
SEARCH_PROVIDER_BASE_URL=
LEARNING_PROVIDER_API_KEY=
LEARNING_PROVIDER_BASE_URL=

# --- Vector DB (wired up in Phase 5) ---
# --- Embedding provider (Phase 5) ---
# mock is not a real provider — RealEmbeddingProvider fails loudly if
# selected without DEMO_MODE=true, same pattern as LLM_PROVIDER above.
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

# --- Vector store (Phase 5) ---
# Unset QDRANT_URL -> Qdrant's embedded local-mode client (on-disk at
# QDRANT_LOCAL_PATH, no server needed). Set QDRANT_URL to point at a real
# Qdrant instance instead (e.g. http://qdrant:6333 in docker-compose).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=pathforge_documents

# --- RAG pipeline bounds (Phase 5) ---
RAG_CHUNK_SIZE_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=200
RAG_MIN_CHUNK_SIZE_CHARS=100
RAG_MAX_DOCUMENT_CHARS=200000
RAG_MAX_CHUNKS_PER_DOCUMENT=500
RAG_MAX_TOP_K=20
RAG_DEFAULT_TOP_K=5
RAG_MAX_CONTEXT_CHARS=8000

# --- Resume analyzer bounds (Phase 6) ---
RESUME_MAX_UPLOAD_BYTES=5000000
RESUME_MAX_TEXT_CHARS=50000
RESUME_MAX_SECTIONS=30
RESUME_MAX_SKILLS=100
RESUME_MAX_EXPERIENCES=30
RESUME_MAX_PROJECTS=30

# --- Job description analyzer bounds (Phase 7) ---
JD_MAX_UPLOAD_BYTES=2000000
JD_MAX_TEXT_CHARS=30000
JD_MAX_SECTIONS=30
JD_MAX_SKILLS=100

# --- Roadmap generation (Phase 8) ---
ROADMAP_STUDY_DAYS_PER_WEEK=5

# --- Assessments + mentor (Phase 12) ---
ASSESSMENT_MAX_ANSWER_CHARS=5000
ASSESSMENT_MAX_CODE_CHARS=10000
MENTOR_MAX_MESSAGE_CHARS=2000
MENTOR_RAG_TOP_K=3
MENTOR_RAG_MIN_SCORE=0.15

# --- Docker Compose (docker-compose.yml refuses to start without the first two) ---
# POSTGRES_PASSWORD=choose-a-strong-password
# SECRET_KEY above must be a random value of >= 32 characters when ENVIRONMENT=production.
# ENVIRONMENT=production   # compose default; docker-compose.dev.yml switches to local
# GITHUB_TOKEN=            # optional; only used when DEMO_MODE=false

# --- Frontend ---
# Compiled into the browser bundle (build arg in Docker): the URL the BROWSER uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
